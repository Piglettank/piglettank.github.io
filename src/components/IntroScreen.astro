---
import GbAnimation from "./GbAnimation.astro";
---

<style is:inline>
  .intro-screen {
    position: fixed;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--charcoal);
    z-index: 10;
  }

  .continue-container {
    animation: reveal ease-in-out alternate infinite 1s 2s;
    opacity: 0;
    text-align: center;
  }

  @keyframes reveal {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<div class="intro-screen">
  <div class="gb-animation-container">
    <GbAnimation text="Piglettank" />
  </div>

  <div class="continue-container">
    <p>- Press any button to continue -</p>
  </div>

  <!--center and lift baby -->

  <div style="height: 20px;"></div>
</div>

<script is:inline>
  // Hide the intro screen on any button press or mouse click
  function hideIntroScreen() {
    const introScreen = document.querySelector(".intro-screen");
    if (introScreen) {
      introScreen.style.display = "none";
      window.removeEventListener("keydown", hideIntroScreen);
      window.removeEventListener("mousedown", hideIntroScreen);
      window.removeEventListener("touchstart", hideIntroScreen);
    }
  }

  window.addEventListener("keydown", hideIntroScreen);
  window.addEventListener("mousedown", hideIntroScreen);
  window.addEventListener("touchstart", hideIntroScreen);
</script>
