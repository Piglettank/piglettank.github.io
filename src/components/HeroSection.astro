---
import pig from "../assets/pig.png";
import { Image } from "astro:assets";
import github_white from "../assets/github_white.png";
import youtube_white from "../assets/youtube_white.png";
import mal_white from "../assets/mal_white.png";
import SocialMediaLink from "./SocialMediaLink.astro";
---

<div class="hero-section">
  <Image src={pig} alt="Me about to smash" class="hero-image" loading="eager" />
  <div class="text">
    <h1
      id="title"
      style="margin-bottom: 0px;"
      role="button"
      tabindex="0"
      aria-label="Click to cycle through greetings in different languages"
      onclick="cycleGreeting()"
    >
      &nbsp; <!-- Empty character to avoid jitter -->
    </h1>
    <p id="subtitle" class="animating" style="margin-top: 8px;">
      Today is
      <span
        id="date"
        onclick="cycleDate()"
        role="button"
        tabindex="0"
        aria-label="Click to cycle through dates in different calendars"></span>
      , it's a good day to be alive.
    </p>
    <div class="social-media-links">
      <SocialMediaLink
        class="social-link-1"
        image={github_white}
        alt="GitHub"
        link="https://github.com/piglettank"
      />
      <SocialMediaLink
        class="social-link-2"
        image={youtube_white}
        alt="Youtube"
        link="https://www.youtube.com/user/Piglettank"
      />
      <SocialMediaLink
        class="social-link-3"
        image={mal_white}
        alt="MyAnimeList"
        link="https://myanimelist.net/mangalist/Piglettank"
      />
    </div>
  </div>
</div>

<style>
  .hero-section {
    display: flex;
    height: 600px;
    align-items: center;
    align-self: center;
    justify-content: center;
    background-size: auto;
    background-repeat: no-repeat;
    margin-top: 80px;
    gap: 40px;
    width: 100%;
  }

  .text {
    flex: 1;
    max-width: 540px;
    color: var(--myWhite);
  }

  #title {
    cursor: pointer;
    display: inline-block;
    transition: all 0.2s ease-out;
  }

  #title:hover {
    color: var(--glow);
    transform: scale(1.05);
  }

  #title:active {
    transform: scale(0.98);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInUpSmall {
    from {
      opacity: 0.5;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
    }
  }

  #title.animating {
    animation: fadeInUp 0.7s ease-out forwards;
  }

  #date {
    cursor: pointer;
    display: inline-block;
    transition: all 0.2s ease-out;
  }

  #date:hover {
    color: var(--glow);
    transform: scale(1.03);
  }

  #date.animating {
    animation: fadeInUpSmall 0.3s ease-out forwards;
  }

  #subtitle {
    opacity: 0;
  }

  #subtitle.animating {
    animation: fadeInUp 0.5s ease-out forwards;
    animation-delay: 0.25s;
  }

  .hero-image {
    width: 400px;
    height: 400px;
    border-radius: 100%;
    object-fit: cover;
  }

  .social-media-links {
    display: flex;
    gap: 16px;
  }

  :global(.social-link-1) {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
    animation-delay: 0.55s;
  }

  :global(.social-link-2) {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
    animation-delay: 0.65s;
  }

  :global(.social-link-3) {
    opacity: 0;
    animation: fadeInUp 0.5s ease-out forwards;
    animation-delay: 0.75s;
  }

  @media screen and (max-width: 760px) {
    .hero-image {
      height: 300px;
      width: 80vw;
      margin-top: 60px;
      object-fit: contain;
    }
    h1 {
      font-size: 30px;
    }
    .hero-section {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      align-items: center;
      text-align: center;
      align-content: center;
      gap: 0px;
      width: 100%;
      padding-bottom: 80px;
      min-height: 480px;
    }

    .social-media-links {
      display: flex;
      justify-content: center;
      gap: 16px;
    }
  }
</style>

<script is:inline>
  const greetings = [
    "Ça va",
    "¡Buenas!",
    "Shalom",
    "おっす！",
    // "押忍!",
    "Tjenixen!",
    "Howdy!",
    "Moin moin",
    "Привіт",
  ];
  let dates = [
    getCurrentGregorianDate(),
    getCurrentIslamicDate(),
    getCurrentHebrewDate(),
  ];

  let currentIndex = Math.floor(Math.random() * greetings.length);
  let currentDateIndex = 0;
  const title = document.getElementById("title");
  const dateElement = document.getElementById("date");

  const animateGreeting = () => {
    title.classList.remove("animating");
    void title.offsetWidth;
    title.classList.add("animating");
  };

  function cycleGreeting() {
    currentIndex = (currentIndex + 1) % greetings.length;
    title.textContent = greetings[currentIndex];
    animateGreeting();
  }

  if (title) {
    title.textContent = greetings[currentIndex];
    animateGreeting();

    title.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        cycleGreeting();
      }
    });
  }

  if (dateElement) {
    dateElement.textContent = getCurrentGregorianDate();

    dateElement.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        cycleDate();
      }
    });
  }

  function cycleDate() {
    currentDateIndex = (currentDateIndex + 1) % dates.length;
    dateElement.textContent = dates[currentDateIndex];
    dateElement.classList.remove("animating");
    void dateElement.offsetWidth;
    dateElement.classList.add("animating");
  }

  function getCurrentHebrewDate() {
    const now = new Date();
    const hebrewDate = new Intl.DateTimeFormat("en-u-ca-hebrew", {
      day: "numeric",
      month: "long",
    }).format(now);
    return hebrewDate;
  }

  function getCurrentIslamicDate() {
    const now = new Date();
    const islamicDate = new Intl.DateTimeFormat("en-u-ca-islamic", {
      day: "numeric",
      month: "long",
    }).format(now);
    return islamicDate;
  }

  function getCurrentGregorianDate() {
    const now = new Date();
    const gregorianDate = new Intl.DateTimeFormat("en-u-ca", {
      day: "numeric",
      month: "long",
    }).format(now);
    return gregorianDate;
  }
</script>
