---
import GbAnimationReact from "./GbAnimation";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<style is:inline>
  .gb-animation-container {
    letter-spacing: 3px;
    font-size: 64px;
    font-family: "GBAFont";
    text-align: center;
  }
  @media screen and (max-width: 768px) {
    .gb-animation-container {
      letter-spacing: 3px;
      font-size: 48px;
      font-family: "GBAFont";
    }
  }

  .gb-char {
    opacity: 1;
    /* background: -webkit-linear-gradient(#eee, #333); */
    /* -webkit-background-clip: text;
    -webkit-text-fill-color: transparent; */

    animation:
      orbit ease-out forwards 1.1s,
      colorChange ease-out forwards 1.1s,
      glow ease-out forwards 0.4s 1.7s;
    display: inline-block;
  }

  .gb-char-invisible {
    opacity: 0;
  }

  @keyframes glow {
    from {
      color: var(--glow);
    }
    50% {
      color: var(--myWhite);
    }
    to {
      color: var(--glow);
    }
  }

  @keyframes colorChange {
    from {
      color: var(--charcoal);
    }
    to {
      color: var(--glow);
    }
  }
  @-webkit-keyframes orbit {
    from {
      -webkit-transform: scale(3.4) rotate(-360deg) translateX(-45px)
        translateY(30px) rotate(360deg);
    }
    75% {
      -webkit-transform: scale(1) rotate(0deg) translateX(0px) translateY(0px)
        rotate(0deg);
    }
    76% {
      -webkit-transform: translateY(0px);
    }
    84% {
      -webkit-transform: translateY(-9px);
    }
    92% {
      -webkit-transform: translateY(0px);
    }
    94% {
      -webkit-transform: translateY(-3px);
    }
    96% {
      -webkit-transform: translateY(0px);
    }
    to {
      -webkit-transform: translateY(0px);
    }
  }
</style>

<div class="gb-animation-container">
  <GbAnimationReact client:load text={text} />
</div>
